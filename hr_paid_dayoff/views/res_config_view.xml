<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
      <!-- Inherit Form View to Modify it -->
      <record id="res_config_settings_view_form_paid_dayoff" model="ir.ui.view">
          <field name="name">res.config.settings.view.form.paid.dayoff</field>
          <field name="model">res.config.settings</field>
          <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
          <field name="arch" type="xml">
              <xpath expr="//app[@name='hr']" position="inside">
                <block title="Piad Time Off" name="paid_timeoff_setting_container">
                    <div class="row mt16 o_settings_container" name="employee_paid_timeoff">
                        <div class="col-12 col-lg-6 o_setting_box" id="employee_paid_timeoff_id">
                            <div class="o_setting_right_pane">
                                <label for="emps_vac_vendor_id"/>
                                <span class="fa fa-lg fa-building-o" title="choose employee vacation vendor." role="img" aria-label="choose vendor of payroll."/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        choose employee vacation vendor 
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="emps_vac_vendor_id" required="1"
                                            class="o_light_label"
                                            />
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="vacation_per_month"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Enter the number of deserved days per month as paid time-off
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="vacation_per_month"  class="o_light_label" />
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="startup_date"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Enter the date of paid time off processing
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="startup_date" widget="date"  class="o_light_label" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>

              </xpath>
          </field>
      </record>
  </data>
</odoo>