<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_distribution" model="ir.ui.view">
        <field name="name">sale.order.form.distribution</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add a temporary payment directly from the order -->
            <xpath expr="//button[@id='create_invoice']" position="before">
                <button name="action_add_distribution_payment" type="object"
                        context="{'order_distribution_payment': True}"
                        string="Add Payment" class="btn-secondary"
                        invisible="not is_distribution_order or state != 'sale'"/>
            </xpath>

            <!-- Distribution orders are never invoiced individually: hide invoice buttons -->
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or is_distribution_order</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or is_distribution_order</attribute>
            </xpath>

            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_distribution_payments" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not is_distribution_order">
                    <field name="distribution_payment_count" widget="statinfo"
                           string="Payments"/>
                </button>
            </xpath>

            <!-- Flags -->
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="is_distribution_order"
                       readonly="state != 'draft'"/>
                <field name="delivery_run_id"
                       invisible="not is_distribution_order"
                       readonly="state != 'draft'"/>
            </xpath>

            <!-- Distribution buffer figures, rendered as extra total lines aligned
                 under the order Total (only for distribution users/managers). -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <group class="oe_subtotal_footer"
                       name="sale_total">
                    <field name="distribution_paid"
                           invisible="not is_distribution_order"
                           groups="wholesale_distribution.group_distribution_user"/>
                    <field name="distribution_validated"
                           invisible="not is_distribution_order"
                           groups="wholesale_distribution.group_distribution_user"/>
                    <field name="distribution_rest"
                           invisible="not is_distribution_order"
                           groups="wholesale_distribution.group_distribution_user"/>
                </group>

            </xpath>

        </field>
    </record>

    <!-- Search view for distribution orders -->
    <record id="view_distribution_order_search" model="ir.ui.view">
        <field name="name">sale.order.search.distribution</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Distribution Orders">
                <field name="name" string="Order"/>
                <field name="partner_id"/>
                <field name="delivery_run_id"/>
                <field name="user_id" string="Distributor"/>
                <filter name="draft" string="Quotations" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <filter name="sale" string="Confirmed" domain="[('state', '=', 'sale')]"/>
                <separator/>
                <filter name="filter_date" string="Order Date" date="date_order"/>
                <group>
                    <filter name="group_run" string="Delivery Run"
                            context="{'group_by': 'delivery_run_id'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Distributor"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_distribution_orders" model="ir.actions.act_window">
        <field name="name">Distribution Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_distribution_order_search"/>
        <field name="domain">[('is_distribution_order', '=', True)]</field>
        <field name="context">{'is_distribution': True, 'default_is_distribution_order': True}</field>
    </record>

    <record id="action_general_orders" model="ir.actions.act_window">
        <field name="name">General Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_distribution_master_order', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No general orders yet</p>
            <p>General orders are the aggregated end-of-day master orders produced by
               batching distribution runs in <b>Close Day</b>.</p>
        </field>
    </record>

</odoo>
