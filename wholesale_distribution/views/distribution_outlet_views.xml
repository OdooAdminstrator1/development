<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_distribution_outlet_list" model="ir.ui.view">
        <field name="name">distribution.outlet.list</field>
        <field name="model">distribution.outlet</field>
        <field name="arch" type="xml">
            <list string="Outlets">
                <field name="name"/>
                <field name="distribution_type"/>
                <field name="location_id"/>
                <field name="truck_number" groups="wholesale_distribution.group_distribution_manager"/>
                <field name="default_distributer_id"/>
            </list>
        </field>
    </record>

    <record id="view_distribution_outlet_form" model="ir.ui.view">
        <field name="name">distribution.outlet.form</field>
        <field name="model">distribution.outlet</field>
        <field name="arch" type="xml">
            <form string="Outlet">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Truck 01 / Downtown Shop"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="distribution_type" widget="radio"/>
                            <field name="umbrella_location_id" invisible="1"/>
                            <field name="location_id"
                                   options="{'no_quick_create': True}"
                                   context="{'default_usage': 'internal',
                                             'default_location_id': umbrella_location_id}"/>
                            <field name="distribution_department_id" invisible="1"/>
                            <field name="default_distributer_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Fleet Details"
                               groups="wholesale_distribution.group_distribution_manager"
                               invisible="distribution_type != 'truck'">
                            <field name="truck_name" required="distribution_type == 'truck'"/>
                            <field name="truck_number" required="distribution_type == 'truck'"/>
                        </group>
                        <group string="Shop Details"
                               invisible="distribution_type != 'shop'">
                            <field name="shop_address" required="distribution_type == 'shop'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_distribution_outlet_search" model="ir.ui.view">
        <field name="name">distribution.outlet.search</field>
        <field name="model">distribution.outlet</field>
        <field name="arch" type="xml">
            <search string="Outlets">
                <field name="name"/>
                <field name="location_id"/>
                <field name="default_distributer_id"/>
                <field name="truck_number"/>
                <filter name="type_truck" string="Trucks"
                        domain="[('distribution_type', '=', 'truck')]"/>
                <filter name="type_shop" string="Shops"
                        domain="[('distribution_type', '=', 'shop')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Outlet Type"
                            context="{'group_by': 'distribution_type'}"/>
                    <filter name="group_distributer" string="Distributer"
                            context="{'group_by': 'default_distributer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_distribution_outlet" model="ir.actions.act_window">
        <field name="name">Outlets</field>
        <field name="res_model">distribution.outlet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
