<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_distribution_payment_list" model="ir.ui.view">
        <field name="name">distribution.payment.list</field>
        <field name="model">distribution.payment</field>
        <field name="arch" type="xml">
            <list string="Payments" editable="bottom">
                <field name="date"/>
                <field name="delivery_run_id"/>
                <field name="sale_order_id"/>
                <field name="partner_id" optional="show"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'collected'"
                       decoration-success="state == 'validated'"/>
            </list>
        </field>
    </record>

    <record id="view_distribution_payment_form" model="ir.ui.view">
        <field name="name">distribution.payment.form</field>
        <field name="model">distribution.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="delivery_run_id" readonly="context.get('order_distribution_payment', False)"/>
                            <field name="sale_order_id" readonly="context.get('order_distribution_payment', False)"/>
                            <field name="partner_id" readonly="context.get('order_distribution_payment', False)"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_distribution_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">distribution.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
