<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_distribution" model="ir.ui.view">
        <field name="name">hr.employee.form.distribution</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Smart button to the related (portal) user -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_user" type="object"
                        class="oe_stat_button" icon="fa-user"
                        invisible="not user_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">User</span>
                    </div>
                </button>
            </xpath>

            <!-- Lock the department when creating from the Distributers action -->
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="readonly">context.get('distribution_distributer', False)</attribute>
            </xpath>

        </field>
    </record>

</odoo>
