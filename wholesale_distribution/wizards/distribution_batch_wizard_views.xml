<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_distribution_batch_wizard_form" model="ir.ui.view">
        <field name="name">distribution.batch.wizard.form</field>
        <field name="model">distribution.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="End-of-Day Aggregation">
                <div class="alert alert-info" role="alert">
                    This generates ONE master sale order (standard sequence) aggregating all
                    selected runs, runs inventory Legs 2 &amp; 3, posts a single master invoice
                    and reconciles every run payment against it.
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="run_filter" widget="radio"/>
                    <field name="excluded_run_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate_master_order" type="object"
                            string="Generate Master Order" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_distribution_batch_wizard" model="ir.actions.act_window">
        <field name="name">End-of-Day Aggregation</field>
        <field name="res_model">distribution.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
