<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Application category & privilege                                -->
    <!-- ============================================================= -->
    <record id="module_category_distribution" model="ir.module.category">
        <field name="name">Wholesale Distribution</field>
        <field name="description">Access rights for the Wholesale Distribution application.</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_distribution" model="res.groups.privilege">
        <field name="name">Wholesale Distribution</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_distribution"/>
    </record>

    <!-- ============================================================= -->
    <!-- Security groups                                                 -->
    <!-- ============================================================= -->
    <record id="group_distribution_user" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Back-office cashier operating delivery runs from the Odoo backend (not the mobile app).</field>
    </record>

    <!-- Portal-side access right for mobile distributers. It must NOT imply
         base.group_user (portal and internal are mutually exclusive). -->
    <record id="group_distribution_portal" model="res.groups">
        <field name="name">Distributer (Portal)</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution"/>
        <field name="comment">Portal user of a field distributer operating via the mobile app.</field>
    </record>

    <record id="group_distribution_manager" model="res.groups">
        <field name="name">Distribution Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_distribution"/>
        <!-- Manager implies the distributor role and a standard salesperson role
             so the aggregated master order (a standard sale.order) is fully usable. -->
        <field name="implied_ids" eval="[(4, ref('group_distribution_user')),
                     (4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Manager / cashier closing runs, managing the fleet and running the end-of-day batch.</field>
    </record>

    <!-- ============================================================= -->
    <!-- Record rules: sale.order visibility isolation                  -->
    <!-- ============================================================= -->

    <!-- Standard Sales users: only NON distribution orders -->
    <record id="sale_order_standard_rule" model="ir.rule">
        <field name="name">Sales: hide distribution orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('is_distribution_order', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Distribution users: only distribution orders -->
    <record id="sale_order_distribution_rule" model="ir.rule">
        <field name="name">Distribution: only distribution orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('is_distribution_order', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_distribution_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================= -->
    <!-- Grant the admin user the Distribution Manager role on install   -->
    <!-- ============================================================= -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_distribution_manager'))]"/>
    </record>

</odoo>
