<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_custom" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='outgoing_delivery_address']/span/strong"
               position="replace">
            <strong>Client Address:</strong>
        </xpath>
        
        <!-- Align the entire address block to the right -->
        <xpath expr="//t[@t-set='address']/div[@name='div_outgoing_address']"
               position="attributes">
            <attribute name="style">text-align: right;</attribute>
        </xpath>
        <xpath expr="//div[@class='page']/h2" position="before">
            <div class="row mt32 mb32">
                <div t-if="o.project_id" class="col-auto me-4" name="div_project_id">
                    <strong>Project ID:</strong>
                    <p t-field="o.project_id"/>
                </div>
                <div t-if="o.project_id" class="col-auto me-4" name="div_project_name">
                    <strong>Project Name:</strong>
                    <p t-field="o.project_name"/>
                </div>
                <div t-if="o.po_no" class="col-auto me-4" name="div_po_number">
                    <strong>PO Number:</strong>
                    <p t-field="o.po_no"/>
                </div>
            </div>
        </xpath>   
        <xpath expr="//div[@name='div_sched_date']" position="after">

            
            <div t-if="o.delivery_location" class="col-auto me-4" name="div_delivery_location">
                <strong>Delivery Location:</strong>
                <p t-field="o.delivery_location"/>
            </div>
            <div t-if="o.subject_of_delivery" class="col-auto" name="div_subject_of_delivery">
                <strong>Subject of Delivery:</strong>
                <p t-field="o.subject_of_delivery"/>
            </div>
        </xpath>

        


        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']"
               position="before">

            <th name="th_sm_serial_number">
                <strong>No.</strong>
            </th>

            <th name="th_sm_pre_sales_code">
                <strong>Code</strong>
            </th>

        </xpath>

        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]"
               position="before">

            <td>
                <span t-out="move.serial_number or ''"/>
            </td>

            <td>
                <span t-out="move.pre_sales_code or ''"/>
            </td>

        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']"
               position="before">

            <th name="th_sml_serial_number">
                <strong>No.</strong>
            </th>
            <th name="th_sml_pre_sales_code">
                <strong>Code</strong>
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']/thead/tr/th[@name='th_sb_product']"
               position="before">
            <th name="th_sb_serial_number">
                <strong>No.</strong>
            </th>
            <th name="th_sb_pre_sales_code">
                <strong>Code</strong>
            </th>
        </xpath>

        <xpath expr="//table[@name='stock_backorder_table']/tbody/tr/td[1]"
               position="before">

            <td>
                <span t-out="bo_line.serial_number or ''"/>
            </td>

            <td>
                <span t-out="bo_line.pre_sales_code or ''"/>
            </td>

        </xpath>
        <!-- Remove Ordered header from pending deliveries -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_ordered']"
               position="replace"/>
        
        <!-- Remove product_uom_qty cell from pending deliveries -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[.//span[@t-field='move.product_uom_qty']]"
               position="replace"/>
        
        <!-- Remove Ordered header from completed deliveries -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_qty_ordered']"
               position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        
    </template>

    <template id="report_delivery_serial_move_line_custom_fields"   inherit_id="stock.stock_report_delivery_has_serial_move_line">

        <xpath expr="//td[.//span[@t-field='move_line.product_id']]"
               position="before">
            <td>
                <span t-out="move_line.move_id.serial_number or ''"/>
            </td>
            <td>
                <span t-out="move_line.move_id.pre_sales_code or ''"/>
            </td>
        </xpath>
    </template>

    <template id="report_delivery_aggregated_move_lines_custom_fields"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr[@t-foreach='aggregated_lines']"
               position="replace">
            <t t-foreach="aggregated_lines" t-as="line">

                <t t-foreach="aggregated_lines[line]['custom_move_values']"
                   t-as="custom_move">

                    <t t-set="custom_move_record"
                       t-value="custom_move['move']"/>

                    <tr>

                        <td>
                            <span t-out="custom_move['serial_number'] or ''"/>
                        </td>

                        <td>
                            <span t-out="custom_move['pre_sales_code'] or ''"/>
                        </td>

                        <td>
                            <span t-out="aggregated_lines[line]['name']"/>

                            <p t-if="aggregated_lines[line]['description']">
                                <span t-out="aggregated_lines[line]['description']"
                                      t-options="{'widget': 'text'}"/>
                            </p>
                        </td>


                        <td class="text-center"
                            name="move_line_aggregated_quantity">

                            <span t-field="custom_move_record.quantity" t-options='{"widget": "float", "precision": 0}' />

                            <span t-field="custom_move_record.product_uom"
                                  groups="uom.group_uom"/>

                            <span t-if="custom_move_record.product_packaging_id">
                                (
                                <span t-field="custom_move_record.product_packaging_quantity"
                                      t-options='{"widget": "integer"}'/>
                                <span t-field="custom_move_record.product_packaging_id"/>
                                )
                            </span>

                        </td>

                    </tr>

                </t>

            </t>

        </xpath>

    </template>

</odoo>
