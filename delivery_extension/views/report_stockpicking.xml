<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_custom" inherit_id="stock.report_delivery_document">
        <!-- Target the metadata block (e.g., after the partner or order reference block) -->
        <xpath expr="//div[@class='page']/h2" position="after">
            <div class="row mt-3 mb-3" name="custom_picking_details">
                <div class="col-12" t-if="o.project_id">
                    <strong>Project ID:</strong> <span t-field="o.project_id"/>
                </div>

                <div class="col-12" t-if="o.delivery_location">
                    <strong>Delivery Location:</strong> <span t-field="o.delivery_location"/>
                </div>
                <div class="col-12" t-if="o.subject_of_delivery">
                    <strong>Subject of Delivery:</strong> <span t-field="o.subject_of_delivery"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='outgoing_warehouse_address']" position="after">
                <div class="text-center w-100" style="font-size: 14px; font-weight: bold; margin-bottom: 10px;">
                    ADVANCE ENERGY SOLUTIONS CO.
                </div>
        </xpath>
    </template>
</odoo>
