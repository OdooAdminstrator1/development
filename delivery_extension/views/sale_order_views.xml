<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_manual_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.manual.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert the selection field above the customer field -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="manual_delivery_id" 
                       invisible="state not in ('draft', 'sent')"
                       readonly="state not in ('draft', 'sent')"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Select existing delivery (Optional)..."/>
            </xpath>
        </field>
    </record>
</odoo>
