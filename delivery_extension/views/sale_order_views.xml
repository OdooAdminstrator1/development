<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_manual_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.manual.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert the selection field above the customer field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="manual_delivery_ids"
                       widget="many2many_tags"
                       invisible="state not in ('draft', 'sent')"
                       readonly="not partner_id"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="Select done deliveries of this customer..."/>
            </xpath>
        </field>
    </record>
</odoo>
