<odoo>
<record id="view_account_form_inherit_advanced" model="ir.ui.view">
        <field name="name">account.account.form</field>
        <field name="model">account.account</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
          <xpath expr="//field[@name='deprecated']" position="after">
                <label for="advanced" string="Advance"/>
                <div>
                    <field name="advanced"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_partner_property_form_advanced" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="advance_account_receivable_id"></field>
                 <field name="advance_account_payable_id"></field>

            </xpath>
        </field>
    </record>
    <record id="view_form_Close_Payment" model="ir.ui.view">
        <field name="name">Close Payment</field>
        <field name="model">account.payment.journal.returned</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form edit="false" >
                   <group>
                    <field name="returned_journal_id"  />

                  </group>
                <group>
                    <field name="payment_id"  />

                  </group>
            </form>
            <footer>
                <button special="cancel" string="Cancel" class="pull-left"/>
                <button name="closeEitDialog" type="object" string="Save" class="oe_highlight pull-right"/>
            </footer>
        </field>
    </record>
	<record model="ir.ui.view" id="account_payment_advance_view">
		<field name="name">account.payment.advance.view</field>
		<field name="model">account.payment</field>
		<field name="inherit_id" ref="account.view_account_payment_form" />
		<field name="arch" type="xml">
			<field name="is_internal_transfer" position="after">
				<field name="advance_ok" invisible="context.get('active_model')=='account.move'" attrs="{'invisible':[('payment_type', 'not in', ('inbound','outbound'))]}"/>

			</field>
            <div name="button_box" position="inside">
                <field name="can_close" invisible="1"/>
                    <button class="oe_stat_button" name="Show_close_payment" string="Close Payment" type="object" attrs="{'invisible':[('can_close','=',False)]}"
                        icon="fa-pencil-square-o" help="return to cash" >

                    </button>
                </div>
		</field>
	</record>
 <record id="act_res_partner_2_advanced_payments" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="domain">[('advance_ok','=',True)]</field>
            <field name="context">{'search_default_partner_id': active_id, 'default_partner_id': active_id}</field>

        </record>

<record id="res_partner_view_purchase_account_buttons" model="ir.ui.view">
            <field name="name">res.partner.view.purchase.account.buttons</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="12"/>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button" name="%(act_res_partner_2_advanced_payments)d" type="action"
                        icon="fa-pencil-square-o" help="Vendor Bills">
                        <field string="Advanced Payments" name="supplier_advanced_count" widget="statinfo"/>
                    </button>
                </div>
            </field>
        </record>




</odoo>

