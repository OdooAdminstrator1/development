<odoo>

    <record id="view_production_order_form" model="ir.ui.view">
        <field name="name">production.order.form</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">
            <form string="Open Order">
                <header>
                    <button name="action_view_sale_orders" type="object" class="oe_highlight" icon="fa-shopping-cart">
                        <field name="sale_order_count" widget="statinfo" string="Sales Orders"/>
                    </button>
                    <button name="action_view_mrp_productions" type="object" class="oe_highlight" icon="fa-industry">
                        <field name="mrp_production_count" widget="statinfo" string="Manufacturing Orders"/>
                    </button>
                    <button name="action_view_purchase_orders" type="object" class="oe_highlight" icon="fa-truck">
                        <field name="purchase_count" widget="statinfo" string=" Purchase Orders "/>
                    </button>
                </header>
                <sheet>
                    <group name="main_group">
                        <group name="group1">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="adopted_date" options="{'format': 'DD-MMM-YYYY'}" />
                            <field name="opportunity_id"/>
                            <field name="row_mat"/>
                            <field name="manufactured"/>
                            <field name="engineer"/>
                            <field name="remark"/>
                        </group>
                        <group name="group2">
                            <field name="expected_revenue" string="Confirmed PO" />
                            <field name="delivery_state"/>
                            <field name="total_invoiced_untaxed"  readonly="1"/>
                            <field name="to_be_invoiced"  readonly="1"/>
                            <field name="total_paid_untaxed"  readonly="1"/>
                            <field name="remaining_val"  readonly="1"/>
                            <field name="total_due"  readonly="1"/> 
                            <field name="old_due"  readonly="1"/> 
                            <field name="partner_id" readonly="1"/>
                            <field name="sales_man" widget="many2many_tags" />
                        </group>
                    </group>
                    <notebook>
                      <page string="Attachments">
                        <field name="file_ids" mode="tree,form"
                               context="{'default_production_order_id': active_id}">
                          <tree>
                            <field name="name"/>
                            <!-- This shows as a download link -->
                            <field name="file_download" filename="name" widget="binary" />
                            <!-- <field name="opportunity_stage" /> -->

                          </tree>
                          <form string="Attachment">
                            <group>
                              <field name="name"/>
                              <!-- Upload / re-upload happens here -->
                              <field name="file" filename="name"/>
                              <!-- <field name="opportunity_stage" /> -->
                            </group>
                          </form>
                        </field>
                      </page>

                      <page string="Finished Products">
                        <field name="product_ids" mode="tree,form"
                            >
                          <tree>
                            <field name="name"/>
                            <field name="product_id" />
                            <field name="qty" />
                            <field name="po_bom" />
                            <field name="row_mat" />
                            
                          </tree>
                          <form string="Finished Product">
                            <group>
                                <field name="name"/>
                                <field name="product_id" />
                                <field name="qty" />
                                <field name="po_bom" />
                            </group>
                          </form>
                        </field>
                      </page>


                        <page string="Available RM">
                            <field name="row_materials_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Unavailable RM">
                            <field name="row_needed_materials_html" nolabel="1" readonly="1"/>
                        </page>
                        
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_production_order_tree" model="ir.ui.view">
        <field name="name">production.order.tree</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">
            <tree string="Open Orders" >
                <header>
                    <button name="action_group_by_quarter" type="object" string="Aggregate by Quarter" class="btn-primary"/>
                </header>
                <field name="name" string="Order Name" />
                <field name="partner_id"/>
                <field name="adopted_date" options="{'format': 'DD-MMM-YYYY'}" />
                <field name="row_mat" widget="badge" string="RM Availability"/>
                <field name="delivery_state"/>
                <field name="manufactured" widget="badge"/>
                <field name="expected_revenue" string="Confirmed PO" sum="Total Confirmed PO" /> 
                <field name="total_invoiced_untaxed" readonly="1" sum="Total Invoiced"/>
                <field name="to_be_invoiced" readonly="1" sum="Total To Be Invoiced"/>
                <field name="total_paid_untaxed" readonly="1" sum="Total Paid" string="Paid" />
                <field name="remaining_val" sum="Total Remaining" readonly="1"/>
                <field name="total_due" sum="Total Due"  readonly="1"/>
                <field name="old_due" sum="Total Old Due" readonly="1"/>
                <field name="remark"  readonly="0" />
                
            </tree>
        </field>
    </record>

    <record id="view_production_order_summary_tree" model="ir.ui.view">
        <field name="name">production.order.summary.tree</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="adopted_date" options="{'format': 'DD-MMM-YYYY'}" />
                <field name="name" string="Order Name" />
                <field name="partner_id"/>
                <field name="expected_revenue" string="Confirmed PO" sum="Total Expected"/>
                <field name="nb_invoices"  sum="NB Invoices" /> 
                <field name="total_invoiced_untaxed" sum="Total Invoiced"/>
                <field name="to_be_invoiced" sum="Total To Be Invoiced"/>
                <field name="total_paid_untaxed" string="Paid" sum="Total Paid"/>
                <field name="remaining_val" sum="Total Remaining" />
                <field name="total_due"  sum="Total Due" />
                <field name="old_due"  sum="Old Due" />
            </tree>
        </field>
    </record>


    <record id="view_production_order_search" model="ir.ui.view">
        <field name="name">production.order.search</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">
            <search string="Search Production Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_ids" string="Sale Order"/>
                <field name="purchase_ids" string="Purchase Order"/>
                <field name="mrp_production_ids" string="Opportunity"/>
            </search>
        </field>
    </record>




    <record id="action_production_order" model="ir.actions.act_window">
        <field name="name">Open Orders</field>
        <field name="res_model">production.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="production_order.view_production_order_tree"/>
        
    </record>

    <record id="action_production_order_summary" model="ir.actions.act_window">
        <field name="name">Open Orders</field>
        <field name="res_model">production.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'group_by': 'adopted_date:quarter'}</field>
        <field name="view_id" ref="production_order.view_production_order_summary_tree"/>
    </record>


    

    <menuitem id="menu_production_order_root" name="Open Orders" sequence="10"/>
    <menuitem id="menu_production_order" name="Browse" parent="menu_production_order_root" action="action_production_order"/>




    <record id="view_order_form_inherit_production_order" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.production.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group" position="after">
                <group>
                    <field name="production_order_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_inherit_production_order" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='reminder']" position="after">
                <field name="production_order_ids" widget="many2many_tags"  groups="sales_team.group_sale_manager" ></field>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_form_inherit_production_order" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.production.order</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group" position="after">
                <group>
                    
                    <field name="production_order_id"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='forecast_availability']"   position="after">
                <field name="other_locations_status" column_invisible="1" />
                <field name="other_locations_qty"
       string="On Hand"
       optional="show"
       decoration-success="other_locations_status == 'enough'"
       decoration-warning="other_locations_status == 'partial'"
       decoration-danger="other_locations_status == 'none'"/>
            </xpath>
        </field>
    </record>


</odoo>
