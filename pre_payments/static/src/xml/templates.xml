<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account.PaymentPopOver" t-inherit="account.PaymentPopOver" t-inherit-mode="extension">
        <xpath expr="//table" position="replace">
            <table class="table table-sm table-borderless mb-0">
                <tr>
                    <td><strong>Amount: </strong></td>
                    <td>
                        <t t-if="line.position === 'before'" t-esc="line.currency"/>
                        <t t-esc="line.amount"/>
                        <t t-if="line.position === 'after'" t-esc="line.currency"/>
                    </td>
                </tr>
                <tr>
                    <td><strong>Memo: </strong></td>
                    <td>
                        <div style="width: 200px; word-wrap: break-word">
                            <t t-esc="line.ref"/>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><strong>Date: </strong></td>
                    <td><t t-esc="line.date"/></td>
                </tr>
                <tr>
                    <td><strong>Journal: </strong></td>
                    <td>
                        <t t-esc="line.journal_name"/>
                        <span t-if="line.payment_method_name"> (<t t-esc="line.payment_method_name"/>)</span>
                    </td>
                </tr>
            </table>
        </xpath>

