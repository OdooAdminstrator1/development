<odoo>
    <record id="view_partner_form_advanced_payment" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="advance_account_receivable_id"></field>
                 <field name="advance_account_payable_id"></field>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_invoice_prepayments" model="ir.ui.view">
        <field name="name">account.move.prepayment.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="due_date"></field>
                <field name="job_no"></field>
            </xpath>
        </field>
    </record> 


    <record model="ir.ui.view" id="account_payment_advance_view">
		<field name="name">account.payment.advance.view</field>
		<field name="model">account.payment</field>
		<field name="inherit_id" ref="account.view_account_payment_form" />
		<field name="arch" type="xml">
			<field name="is_internal_transfer" position="after">
				<field name="advance_ok" invisible="context.get('active_model')=='account.move'" attrs="{'invisible':[('payment_type', 'not in', ('inbound','outbound'))]}"/>
			</field>
            <field name="date" position="before">
				<field name="taxes" widget="many2many_tags" attrs="{'invisible':['|',('advance_ok', '!=', True),('payment_type','=','outbound')]}"/>
				<field name="total_tax_amount" attrs="{'invisible':['|',('advance_ok', '!=', True),('payment_type','=','outbound')]}"/>
				<field name="total_payment" attrs="{'invisible':['|',('advance_ok', '!=', True),('payment_type','=','outbound')]}"/>
            </field>
		</field>
    </record>
    
    <record id="view_account_form_inherit_advanced" model="ir.ui.view">
            <field name="name">account.account.form</field>
            <field name="model">account.account</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_account_form" />
            <field name="arch" type="xml">
            <xpath expr="//field[@name='deprecated']" position="after">
                    <label for="advanced" string="Advance"/>
                    <div>
                        <field name="advanced"/>
                    </div>
                </xpath>
            </field>
    </record>

    <template id="iyCustom_layout_standard">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row">
                <div class="col-3 mb-1">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/>
                </div>
                <div class="col-9 text-center" style="font-size: 0.9rem">
                    <div class="text-center"><strong>Advanced Energy Solutions Company </strong></div>
                    <div class="text-center">Salah al din al ayoubi Rd, Al Malaz Dist, Riyadh 12627</div>
                    <div class="text-center">Office Address: Oumro Al Qais, As Sulimaniyah, Riyadh 12245, Saudi Arabia</div>
                </div>
            </div>

            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout {{ 'o_layout_background' if company.layout_background in ['Geometric', 'Custom'] else '' }}" 
             t-attf-style="background-image: url({{ 'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else '/base/static/img/bg_background_template.jpg' if company.layout_background == 'Geometric' else ''}});" 
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div class="pt-1">
                </div>
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="text-start" style="border-top: 1px solid black;">
                <ul class="list-inline mb-1">
                    <div class="row">
                        <div class="col-4 text-start" style="font-size: 0.9rem">
                            <div class="text-start">Email: inquiry@aesco.com.sa</div>
                            <div class="text-start">Website: aesco.sa</div>
                            <div class="text-start">Telephone: 0112244110</div>
                        </div>
                        <div class="col-4 text-start" style="font-size: 0.9rem">
                            <div class="text-start">Cr: 1010621537</div>
                            <div class="text-start">VAT: 310494952600003</div>
                        </div>
                        <div class="col-4 text-start" style="font-size: 0.9rem">
                            <div class="text-start"><strong>some data1</strong></div>
                            <div class="text-start">some data2</div>
                            <div class="text-start">3rd line</div>
                            <div class="text-start">4th line</div>
                        </div>
                    </div>
                </ul>

                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>

    <template id="iyCustom_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <t t-call="pre_payments.iyCustom_layout_standard"><t t-out="0"/></t>
    </template>


	<template id="report_invoice_document_custom" inherit_id="account.report_invoice_document">
        <xpath expr="." position="replace">
            <t t-call="pre_payments.iyCustom_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> 
                <t t-set="address">
                    <address t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                    <div t-if="o.partner_id.vat" class="mt-3">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                </t>
                <div class="page">
                    <div class="row">
                        <div class="col-4">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'"><h2>Draft Invoice</h2></span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            <span t-if="o.name != '/'"><strong t-field="o.name" /></span>
                            <t t-if="o.qr_code">
                                <div class="col-auto col-3 mw-100 mb-2 qr-code-section" name="qr_code">
                                    <img style="max-height:128px" t-att-src="'data:image/png;base64,' + o.qr_code.decode('utf-8')" alt="QR Code"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-8">
                            <div class="row">
                                <div class="col-sm-5 ms-auto">
                                    <strong t-field="o.partner_id.name" />
                                </div>
                            </div>
                            <t t-call="web.address_layout"/>
                        </div>
                    </div>

                    <div id="informations" class="row mt-4 mb-4">
                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">
                            <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date:</strong></t>
                            <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>
                            <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date:</strong></t>
                            <t t-else=""><strong>Date:</strong></t>
                            <p class="m-0" t-field="o.invoice_date"/>
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice'" name="delivery_date">
                            <strong>Delivery Date:</strong>
                            <p class="m-0" t-field="o.invoice_date_due"/>
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.ref" name="customer_code">
                            <strong>Customer Code:</strong>
                            <p class="m-0" t-field="o.partner_id.ref"/>
                        </div>
                        <div class="col-auto col-3 mw-100 mb-2" t-if="o.job_no" name="job_no">
                            <strong>Job No:</strong>
                            <p class="m-0" t-field="o.job_no"/>
                        </div>
                    </div>

                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                    <table class="table table-sm o_main_table" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th name="th_description" class="text-start"><span>Description</span></th>
                                <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Disc.%</span>
                                </th>
                                <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                <th name="th_subtotal" class="text-end">
                                    <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                        <td name="account_invoice_line_name"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.discount"/>
                                        </td>
                                        <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>

                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99">
                                            <strong class="me-3">Subtotal</strong>
                                            <span t-esc="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm" style="page-break-inside: avoid;">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-call="account.document_tax_totals"/>

                                    <t t-if="print_with_payments">
                                        <t t-if="o.payment_state != 'invoicing_legacy'">
                                            <t t-set="payments_vals" t-value="o.sudo()._get_reconciled_info_values()"/>
                                            <t t-foreach="payments_vals" t-as="payment_vals">
                                                <tr>
                                                    <td colspan="2">
                                                        <i class="oe_form_field text-end oe_payment_label">Paid on: <t t-esc="payment_vals['date']" t-options='{"widget": "date"}'/>
                                                        &#160; &#160; <t t-if="payment_vals['tax']">Paid tax: <span t-esc="payment_vals['tax']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></t>
                                                        &#160; &#160; Total paid <span t-esc="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></i>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="len(payments_vals) > 0">
                                                <tr class="border-black">
                                                    <td><strong>Amount Due</strong></td>
                                                    <td class="text-end">
                                                        <span t-field="o.amount_residual"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </table>
                            </div>
                        </div>
                    </div>
                    <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">
                        Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b>
                    </p>
                    <p t-if="o.invoice_payment_term_id" name="payment_term">
                        <span t-field="o.invoice_payment_term_id.note"/>
                    </p>
                    <div t-if="not is_html_empty(o.narration)" name="comment">
                        <span t-field="o.narration"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template> 

    <template id="custom_payment_report" inherit_id="account.report_payment_receipt_document">
        <xpath expr="." position="replace">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <div class="page">
                    <h3><strong>Payment Receipt: <span t-field="o.name"/></strong></h3>
                    
                    <div class="mb-4 mt-3">
                        <div class="row">
                            <div class="col-6" t-if="o.date">
                                <strong>Payment Date: </strong><span t-field="o.date"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" t-if="o.partner_type">
                                <strong>
                                    <t t-if="o.partner_type == 'customer'">Customer: </t>
                                    <t t-if="o.partner_type == 'supplier'">Vendor: </t>
                                </strong>
                                <span t-field="o.partner_id"/>
                            </div>
                            <div class="col-6" t-if="o.payment_method_id">
                                <strong>Payment Method: </strong><span t-field="o.payment_method_line_id.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" t-if="o.amount">
                                <strong>Payment Amount: </strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                            <div class="col-6" t-if="o.ref">
                                <strong>Memo: </strong><span t-field="o.ref"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6" t-if="'total_tax_amount' in o._fields and o.total_tax_amount">
                                <strong>Tax amount: </strong><span t-field="o.total_tax_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                            <div class="col-6" t-if="'total_payment' in o._fields and o.total_payment">
                                <strong>Total payment: </strong><span t-field="o.total_payment" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                        </div>

                        <div class="row" t-if="o.move_id.display_qr_code">
                            <div class="col-6 qr-code-section">
                                <img t-if="o.move_id.qr_code" style="max-height:64px" class="border border-dark rounded" t-att-src="'data:image/png;base64,' + o.move_id.qr_code" alt="QR Code"/>
                            </div>
                        </div>
                    </div>

                    <t t-set="partials" t-value="o.move_id._get_reconciled_invoices_partials()"/>
                    <t t-set="invoices" t-value="{partial[2].move_id for partial in partials}"/>
                    
                    <t t-set="otherCurrency" t-value="any(inv.currency_id != par[2].currency_id for inv in invoices for par in inv._get_reconciled_invoices_partials())"/>

                    <table class="table table-sm mt-4">
                        <thead>
                            <tr>
                                <th><span>Invoice Date</span></th>
                                <th><span>Invoice Number</span></th>
                                <th><span>Reference</span></th>
                                <th t-if="otherCurrency" class="text-end"><span>Amount In Currency</span></th>
                                <th class="text-end"><span>Total Amount</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <t t-if="inv.move_type != 'entry'">
                                    <tr>
                                        <td><span t-field="inv.invoice_date"/></td>
                                        <td><span t-field="inv.name"/></td>
                                        <td><span t-field="inv.ref"/></td>
                                        <td t-if="otherCurrency"/>
                                        <td class="text-end"><span t-field="inv.amount_total"/></td>
                                    </tr>
                                    <tr t-foreach="inv._get_reconciled_invoices_partials()" t-as="par">
                                        <t t-set="payment" t-value="par[2].move_id"/>
                                        <td colspan="3" class="ps-4">
                                            <span class="text-muted">
                                                <i> ................ Payment on: <span t-field="payment.date"/> </i>
                                                <i class="ms-2">Ref: <span t-field="payment.name"/></i>
                                            </span>
                                        </td>
                                        <t t-set="amountPayment" t-value="-payment.amount_total"/>
                                        <t t-set="amountInvoice" t-value="-par[1]"/>
                                        <t t-set="currencyPayment" t-value="payment.currency_id"/>
                                        <t t-set="currencyInvoice" t-value="inv.currency_id"/>
                                        
                                        <td t-if="otherCurrency" class="text-end">
                                            <span t-if="currencyPayment != currencyInvoice" t-esc="amountPayment" t-options="{'widget': 'monetary', 'display_currency': currencyPayment}"/>
                                        </td>
                                        <td class="text-end">
                                            <i><span t-esc="amountInvoice" t-options="{'widget': 'monetary', 'display_currency': currencyInvoice}"/></i>
                                        </td>
                                    </tr>
                                    <tr class="border-black">
                                        <td colspan="3"/>
                                        <td t-if="otherCurrency"/>
                                        <td class="text-end border-top">
                                            <strong>Due: <span t-field="inv.amount_residual"/></strong>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template> 

</odoo>
