<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="loan_view_move_form_inherited" model="ir.ui.view">
            <field name="name">loan.view_move_form.inherited</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="has_loan" invisible="1" />
                     <button name="show_journal_loan_retreived" string='Loan Journals'
                                type='object' groups="account.group_account_invoice"
                                class="oe_stat_button"
                                icon="fa-check"
                                attrs="{'invisible': [('has_loan','=',False)]}"/>
                </xpath>
            </field>
         </record>
    </data>
</odoo>