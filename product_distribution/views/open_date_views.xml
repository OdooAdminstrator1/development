<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distribution_open_date_form" model="ir.ui.view">
        <field name="name">distribution.open.date.form</field>
        <field name="model">distribution.open.date</field>
        <field name="arch" type="xml">
            <form string="Open Day">
                <header>
                    <button name="action_validate_session" string="confirm" type="object" class="oe_highlight" invisible="status != 'prepare'"/>
                    <button name="action_close_session" string="Close Session" type="object" class="oe_highlight" invisible="status == 'close'"/>
                    <field name="status" widget="statusbar" statusbar_visible="prepare,confirm,running,close"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="session_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="startup_date" readonly="status != 'prepare'"/>
                        </group>
                        <group>
                            <field name="close_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Distributors in Charge">
                            <field name="distributor_line_ids" model="distribution.open.date.line">
                                <tree editable="bottom">
                                    <field name="distributor_id"/>
                                    <field name="state"/>
                                    <field name="actual_value"/>
                                    <field name="expected_value"/>
                                    <field name="picking_id" readonly="1" widget="many2one_button"/>
                                    <button name="action_generate_internal_transfer" 
                                                type="object" 
                                                string="Generate Transfer" 
                                                icon="fa-truck" 
                                                invisible="(picking_id != False) or (state!='loading')"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <record id="view_distribution_open_date_list" model="ir.ui.view">
        <field name="name">distribution.open.date.list</field>
        <field name="model">distribution.open.date</field>
        <field name="arch" type="xml">
            <tree string="Open Day">
                <field name="session_id"/>
                <field name="startup_date"/>
                <field name="count_distributors"/>
                <field name="status"  widget="badge" />
                    
            </tree>
        </field>
    </record>

    <record id="action_distribution_open_date" model="ir.actions.act_window">
        <field name="name">Open Days</field>
        <field name="res_model">distribution.open.date</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_open_date" name="Open Days" parent="menu_distribution_operations" action="action_distribution_open_date" sequence="20"/>
</odoo>