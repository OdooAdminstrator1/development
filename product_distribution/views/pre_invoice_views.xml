<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_distribution_pre_invoice_tree" model="ir.ui.view">
        <field name="name">distribution.pre.invoice.tree</field>
        <field name="model">distribution.pre.invoice</field>
        <field name="arch" type="xml">
            <tree string="Pre-Invoices">
                <field name="distributor_id"/>
                <field name="client_id"/>
                <field name="open_date_id"/>
                <field name="sale_order_id" readonly="1"/> <field name="payment_id" readonly="1"/>
                <field name="total_value"/>
                <field name="received_amount"/>
                <field name="posted_amount"/>
                <field name="rest_amount"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'partially_paid'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_distribution_pre_invoice_form" model="ir.ui.view">
        <field name="name">distribution.pre.invoice.form</field>
        <field name="model">distribution.pre.invoice</field>
        <field name="arch" type="xml">
            <form string="Pre-Invoice">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,partially_paid,paid,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Logistics Information">
                            <field name="distributor_id" readonly="state == 'done'"/>
                            <field name="client_id" readonly="state == 'done'"/>
                            <field name="open_date_id" readonly="state == 'done'"/>
                        </group>
                        <group string="References &amp; Currency">
                            <field name="currency_id" readonly="state == 'done'"/>
                            <field name="sale_order_id" readonly="1"/> <field name="payment_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Financial Accounting Metrics">
                            <field name="total_value"/>
                            <field name="received_amount" readonly="state == 'done'"/>
                        </group>
                        <group string="Balances Tracking">
                            <field name="posted_amount" readonly="1"/>
                            <field name="rest_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pre-Invoice Lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_distribution_pre_invoice" model="ir.actions.act_window">
        <field name="name">Pre-Invoices</field>
        <field name="res_model">distribution.pre.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_pre_invoice" name="Pre-Invoices" parent="menu_distribution_operations" action="action_distribution_pre_invoice" sequence="10"/>

    <record id="action_generate_sale_order_multi" model="ir.actions.server">
        <field name="name">Generate Sale Order</field>
        <field name="model_id" ref="model_distribution_pre_invoice"/>
        <field name="binding_model_id" ref="model_distribution_pre_invoice"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_generate_sale_order()
        </field>
    </record>
</odoo>