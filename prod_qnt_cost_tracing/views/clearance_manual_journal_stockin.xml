<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE clearance.stockin.manual.journal===================== -->
    <record id="view_clearance_manual_stockin_tree" model="ir.ui.view">
        <field name="name">clearance.stockin.manual.journal.tree</field>
        <field name="model">clearance.stockin.manual.journal</field>
        <field name="arch" type="xml">
            <tree string="Manual Journal Stockin" create="false" edit="false" delete="false">
                <field name="move_id"/>
                <field name="date"/>
                <field name="balance"/> 
            </tree>
        </field>
    </record>

    <!-- ===================== FORM  clearance.stockin.manual.journal===================== -->
<record id="view_clearance_manual_stockin_form" model="ir.ui.view">
    <field name="name">clearance.stockin.manual.journal.form</field>
    <field name="model">clearance.stockin.manual.journal</field>
    <field name="arch" type="xml">
        <form string="Manual Journal Stockin" create="false" edit="false" delete="false">
            <sheet>
                <group>
                    <field name="move_id"/>
                    <field name="date"/>
                    <field name="balance"/> 
                </group>
            </sheet>
        </form>
    </field>
    </record>
</odoo>