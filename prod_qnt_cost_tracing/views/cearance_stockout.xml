<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE clearance acc analysis===================== -->
    <record id="view_clearance_stockout_so_tree" model="ir.ui.view">
        <field name="name">clearance.stockout.sorder.tree</field>
        <field name="model">clearance.stockout.sorder</field>
        <field name="arch" type="xml">
            <tree string="Clearance Account Analysis" create="false" edit="false" delete="false">
                <field name="order_id"/>
                <field name="date"/>
                <field name="sumstock"/>
                <field name="sumbill"/>
                <field name="balance"/> 
                <field name="pricediff"/> 
            </tree>
        </field>
    </record>

    <!-- ===================== FORM  clearance acc analysis===================== -->
    <record id="view_clearance_stockout_so_form" model="ir.ui.view">
        <field name="name">clearance.stockout.sorder.form</field>
        <field name="model">clearance.stockout.sorder</field>
        <field name="arch" type="xml">
            <form string="Clearance Account Analysis" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="date"/>
                            <field name="sumstock"/>
                            <field name="sumbill"/>
                            <field name="balance"/> 
                            <field name="pricediff"/> 
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    
    
    </record>






</odoo>