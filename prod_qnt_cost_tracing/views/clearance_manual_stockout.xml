<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE clearance.stockout.manual===================== -->
    <record id="view_clearance_manual_stockout_tree" model="ir.ui.view">
        <field name="name">clearance.stockout.manual.tree</field>
        <field name="model">clearance.stockout.manual</field>
        <field name="arch" type="xml">
            <tree string="Clearance Update Qnt-Cost Stockout" create="false" edit="false" delete="false">
                <field name="move_id"/>
                <field name="date"/>
                <field name="stock_move_type"/>
                <field name="balance"/> 
            </tree>
        </field>
    </record>

    <!-- ===================== FORM  clearance.stockout.manual===================== -->
<record id="view_clearance_manual_stockout_form" model="ir.ui.view">
    <field name="name">clearance.stockout.manual.form</field>
    <field name="model">clearance.stockout.manual</field>
    <field name="arch" type="xml">
        <form string="Clearance Update Qnt-Cost Stockout" create="false" edit="false" delete="false">
            <sheet>
                <group>
                    <field name="move_id"/>
                    <field name="date"/>
                    <field name="stock_move_type"/>
                    <field name="balance"/> 
                </group>
            </sheet>
        </form>
    </field>
    </record>
</odoo>