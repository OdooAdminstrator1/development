<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record model="ir.ui.view" id="product_form_view_procurement_trace_button">
            <field name="name">product.product.procurement.trace</field>
            <field name="model">product.product</field>
            <field name="groups_id" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//button[@name='action_view_stock_move_lines']" position="after">
                        <button type="object"
                            name= "action_view_stock_product_trace"
                            attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}"
                            class="oe_stat_button" icon="fa-exchange"
                            groups="stock.group_stock_user">
                            <div class="o_field_widget o_stat_info mr4">
                                <span class="o_stat_text">InOut Plus</span>
                            </div>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="nbr_moves_trace"/></span>
                            </div>
                        </button>
                    </xpath>
                </data>
            </field>
        </record>


        <record id="stock_product_trace_action" model="ir.actions.act_window">
                <field name="name">Product Trace</field>
                <field name="res_model">stock.product.trace</field>
                <field name="type">ir.actions.act_window</field>
                <field name="view_mode">tree,form</field>
                <field name="view_id" ref="view_stock_product_trace_tree"/>
                <!-- <field name="context">{'search_default_filter_last_12_months': 1, 'search_default_done': 1, 'search_default_groupby_product_id': 1, 'create': 0}</field> -->
                <field name="help" type="html">
                    <p class="o_view_nocontent_empty_folder">
                        There's no product trace yet
                    </p><p>
                        This menu gives you more detailed traceability of inventory operations on a specific product.
                    </p>
                </field>
        </record>

</odoo>
