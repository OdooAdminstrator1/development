<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== TREE clearance.stockin.landedcost===================== -->
    <record id="view_clearance_landed_stockin_tree" model="ir.ui.view">
        <field name="name">clearance.stockin.landedcost.tree</field>
        <field name="model">clearance.stockin.landedcost</field>
        <field name="arch" type="xml">
            <tree string="Clearance Landed Cost Analysis" create="false" edit="false" delete="false">
                <field name="landedcost_id"/>
                <field name="vendor_bill_id"/>
                <field name="date"/>
                <field name="sumstock"/>
                <field name="sumbill"/>
                <field name="balance"/> 
            </tree>
        </field>
    </record>

    <!-- ===================== FORM  clearance.stockin.landedcost===================== -->
    <record id="view_clearance_landed_stockin_form" model="ir.ui.view">
        <field name="name">clearance.stockin.landedcost.form</field>
        <field name="model">clearance.stockin.landedcost</field>
        <field name="arch" type="xml">
            <form string="Clearance Landed Cost Analysis" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="landedcost_id"/>
                            <field name="vendor_bill_id"/>
                            <field name="date"/>
                            <field name="sumstock"/>
                            <field name="sumbill"/>
                            <field name="balance"/> 
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    
    
    </record>
</odoo>