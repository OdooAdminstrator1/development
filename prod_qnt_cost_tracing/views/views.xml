<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_stock_product_trace_tree" model="ir.ui.view">
        <field name="name">stock.product.trace.tree</field>
        <field name="model">stock.product.trace</field>
        <field name="arch" type="xml">
            <!-- <header>
                <button name="open_date_filter" type="object" string="Last Accounting date" class="btn-primary"/>
            </header> -->
            <tree string="Product Traces" create="false" >
                <field name="id"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="stock_move_type"/>
                <field name="qty_old"/>
                <field name="qty_done"/>
                <field name="qty_new"/>
                <field name="cost_old_value"/>
                <field name="cost_unit_value"/>
                <field name="cost_new_value"/>
                <field name="cost_system"/>
                <field name="ref_value"/>
                <field name="reference"/>
                <field name="move_id"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>


    <record id="view_stock_product_trace_search" model="ir.ui.view">
        <field name="name">stock.product.trace.search</field>
        <field name="model">stock.product.trace</field>
        <field name="arch" type="xml">
            <search string="Search Product Trace">
                <field name="product_id"/>
                <field name="attribute_search" string="Attribute Values"/>
                <field name="reference"/>
                <field name="ref_value"/>
                <separator/>
                <field name="stock_move_type"/>
                <field name="move_id"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="date"/>
                <!-- Filters -->
                <filter string="Purchases" name="purchase" domain="[('stock_move_type', '=', 'preceipt')]"/>
                <filter string="Sales" name="sales" domain="[('stock_move_type', '=', 'sdeliver')]"/>
                <filter string="Adjustment" name="adjustment" domain="[('stock_move_type', '=', 'adjustment')]"/>

                <!-- Group By Section -->
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Move Type" name="group_move_type" context="{'group_by':'stock_move_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>



    <!-- Form View -->
    <record id="view_stock_product_trace_form" model="ir.ui.view">
        <field name="name">stock.product.trace.form</field>
        <field name="model">stock.product.trace</field>
        <field name="arch" type="xml">
            <form string="Product Trace">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="product_id"/>
                            <field name="stock_move_type"/>
                            <field name="reference"/>
                            <field name="ref_value"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="move_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <separator string="Quantities"/>
                    <group>
                        <field name="qty_old"/>
                        <field name="qty_done"/>
                        <field name="qty_new"/>
                    </group>
                    <separator string="Cost Information"/>
                    <group>
                        <field name="cost_old_value"/>
                        <field name="cost_unit_value"/>
                        <field name="cost_new_value"/>
                        <field name="cost_system"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stock_product_trace" model="ir.actions.act_window">
        <field name="name">Product Traces</field>
        <field name="res_model">stock.product.trace</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_stock_product_trace_tree"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Here you can review all product quantity and cost changes in the system.</p>
        </field>

    </record>

    <record id="view_stock_product_trace_wizard_form" model="ir.ui.view">
        <field name="name">stock.product.trace.wizard.form</field>
        <field name="model">stock.product.trace.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter by Accounting Date">
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_apply_filter" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_template_trace" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field> <!-- remove active_id references -->
        <field name="domain">[]</field>
    </record>

    <record id="action_product_variant_trace" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <record id="action_customer_invoices_trace" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer invoice
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_stock_product_trace_root"
              name="Business Data Analysis"
              web_icon="prod_qnt_cost_tracing,static/description/icon.png"
              sequence="99"/>

    <menuitem id="menu_stock_product_trace_product"
              name="Products"
              parent="menu_stock_product_trace_root"
              action="action_stock_product_trace"
              sequence="100" />
    <record id="menu_stock_product_trace_product_template" model="ir.ui.menu">
        <field name="name">Products</field>
        <field name="parent_id" ref="prod_qnt_cost_tracing.menu_stock_product_trace_product"/>
        <field name="action" ref="prod_qnt_cost_tracing.action_product_template_trace"/>
        <field name="sequence">110</field>
    </record>
    
    <record id="menu_stock_product_trace_product_variant" model="ir.ui.menu">
        <field name="name">Product Variants</field>
        <field name="parent_id" ref="prod_qnt_cost_tracing.menu_stock_product_trace_product"/>
        <field name="action" ref="prod_qnt_cost_tracing.action_product_variant_trace"/>
        <field name="sequence">120</field>
    </record>

    <menuitem id="menu_stock_product_trace"
              name="Products Trace"
              parent="menu_stock_product_trace_product"
              action="action_stock_product_trace"
              sequence="130" />
              
    <menuitem id="menu_stock_product_trace_invoice"
              name="Invoices"
              parent="menu_stock_product_trace_root"
              sequence="200" />
    <menuitem id="Invoices" name="Invoices" 
    action="action_customer_invoices_trace"
    parent="menu_stock_product_trace_invoice" sequence="240" />



    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_invoice_trace_report_tree" model="ir.ui.view">
        <field name="name">invoice.trace.report.tree</field>
        <field name="model">invoice.trace.report</field>
        <field name="arch" type="xml">
            <tree string="Tracing Invoices" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="product_id"/>
                <field name="display_name"/>
                <field name="quantity" />
                <field name="price_unit"/>
                <field name="cost_unit_value"/>
                <field name="cost_system"/>
                <field name="qty_done"/>
                <field name="qty_new"/>
                <field name="invoice_origin"/>
            </tree>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_invoice_trace_report_form" model="ir.ui.view">
        <field name="name">invoice.trace.report.form</field>
        <field name="model">invoice.trace.report</field>
        <field name="arch" type="xml">
            <form string="Tracing Invoices" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="invoice_origin"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="display_name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                        </group>
                    </group>

                    <group string="Cost Information" col="4">
                        <field name="cost_unit_value"/>
                        <field name="cost_system"/>
                        <field name="currency_id"/>
                    </group>

                    <group string="Quantities" col="2">
                        <field name="qty_done"/>
                        <field name="qty_new"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_invoice_trace_report_search" model="ir.ui.view">
        <field name="name">invoice.trace.report.search</field>
        <field name="model">invoice.trace.report</field>
        <field name="arch" type="xml">
            <search string="Tracing Invoices">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="invoice_origin"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
                <filter name="this_month" string="This Month" domain="[('date', '>=', context_today().strftime('%%Y-%%m-01'))]"/>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_invoice_trace_report" model="ir.actions.act_window">
        <field name="name">Invoice Tracing Analysis</field>
        <field name="res_model">invoice.trace.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>This report shows traced invoices with cost and quantity movements.</p>
        </field>
    </record>

    <!-- ===================== MENU ITEMS ===================== -->


    <menuitem id="menu_invoice_trace_report"
              name="Invoice Tracing Analysis"
              parent="menu_stock_product_trace_invoice"
              action="action_invoice_trace_report"
              sequence="250" />


    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_invoice_detailed_report_tree" model="ir.ui.view">
        <field name="name">invoice.detailed.report.tree</field>
        <field name="model">invoice.detailed.report</field>
        <field name="arch" type="xml">
            <tree string="Detailed Invoices" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="product_id"/>
                <field name="display_name"/>
                <field name="quantity" />
                <field name="price_unit"/>
                <field name="cost_unit"/>
                <field name="currency_id"/>
                <field name="amount_currency" widget="monetary"/>
                <field name="invoice_origin"/>
            </tree>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_invoice_detailed_report_form" model="ir.ui.view">
        <field name="name">invoice.detailed.report.form</field>
        <field name="model">invoice.detailed.report</field>
        <field name="arch" type="xml">
            <form string="Detailed Invoices" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="invoice_origin"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="display_name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="cost_unit"/>
                            <field name="amount_currency" widget="monetary"/>
                            <field name="currency_id"/>

                        </group>
                    </group>


                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_invoice_detailed_report_search" model="ir.ui.view">
        <field name="name">invoice.detailed.report.search</field>
        <field name="model">invoice.detailed.report</field>
        <field name="arch" type="xml">
            <search string="Detailed Invoices">
                <field name="name"/>
                <field name="product_id"/>
                <field name="attribute_search" string="Attribute Values"/>
                <field name="display_name"/>
                <field name="invoice_origin"/>
                <field name="date"/>
                <field name="partner_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today())]"/>
                <filter name="this_month" string="This Month" domain="[('date', '>=', context_today().strftime('%%Y-%%m-01'))]"/>
            </search>
        </field>
    </record>

    <record id="action_invoice_Detailed_report" model="ir.actions.act_window">
        <field name="name">Detailed Invoices</field>
        <field name="res_model">invoice.detailed.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>This report shows detailed invoices.</p>
        </field>
    </record>

    <menuitem id="menu_invoice_detailed_report"
              name="Detailed Invoices"
              parent="menu_stock_product_trace_invoice"
              action="action_invoice_Detailed_report"
              sequence="245" />
    

    <record id="view_res_config_settings_inherit__productrace_sale" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.productrace.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
        
            <xpath expr="//div[@name='invoicing_setting_container']" position="inside">

                    <div class="col-12 col-lg-6 o_setting_box" >
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Business Analysis configuration</span>
                                <div class="text-muted"> Accounts and Journals that used for product cost</div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="cost_account_ids" class="col-lg-5 o_light_label" style="white-space: nowrap;"/>
                                        <field name="cost_account_ids" class="col-lg-7 ms-2" options="{'no_create_edit': True}" widget="many2many_tags"/>
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="cost_journal_ids" class="col-lg-5 o_light_label" style="white-space: nowrap;" />
                                        <field name="cost_journal_ids" class="col-lg-7 ms-2" options="{'no_create_edit': True}" widget="many2many_tags"/>
                                    </div>
                                </div>
                            
                            </div>
                    </div>

                    

            </xpath>

        </field>
    </record>

    <menuitem id="menu_stock_product_trace_orders"
              name="Orders"
              parent="menu_stock_product_trace_root"
              sequence="300" />

    <record id="action_stock_product_trace_Sale_orders" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_stock_product_trace_Sale_orders"
              name="Sale Orders"
              parent="menu_stock_product_trace_orders"
              action="action_stock_product_trace_Sale_orders"
              sequence="310" />

    <record id="action_stock_product_trace_Purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_stock_product_trace_Purchase_orders"
              name="Purchase Orders"
              parent="menu_stock_product_trace_orders"
              action="action_stock_product_trace_Purchase_orders"
              sequence="320" />

    <record id="action_stock_product_trace_mpr_orders" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_stock_product_trace_mpr_orders"
              name="Manufacturing Orders"
              parent="menu_stock_product_trace_orders"
              action="action_stock_product_trace_mpr_orders"
              sequence="330" />

    <record id="action_stock_product_trace_transfers" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_stock_product_trace_transfers"
              name="Transfers"
              parent="menu_stock_product_trace_orders"
              action="action_stock_product_trace_transfers"
              sequence="340" />


</odoo>







