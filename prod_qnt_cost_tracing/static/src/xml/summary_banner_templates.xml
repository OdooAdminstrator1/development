<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="prod_qnt_cost_tracing.SummaryBannerRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//table" position="before">
            <div t-if="Object.keys(state.bannerData).length > 0" class="my-custom-list-banner bg-light border-bottom p-2">
                <div class="d-flex flex-wrap gap-4 justify-content-center">
                    <t t-foreach="state.bannerData" t-as="key" t-key="key">
                        <div class="json-item shadow-sm p-2 bg-white rounded border">
                            <span class="fw-bold text-primary" t-esc="state.labels[key] || key"/>: 
                            <span class="ms-1" t-esc="state.bannerData[key]"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>