<!-- views/notification_config_views.xml -->
<odoo>
    <record id="view_purchase_notification_config_form" model="ir.ui.view">
        <field name="name">purchase.notification.config.form</field>
        <field name="model">purchase.notification.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_notification_config_tree" model="ir.ui.view">
        <field name="name">purchase.notification.config.tree</field>
        <field name="model">purchase.notification.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_purchase_notification_config" model="ir.actions.act_window">
        <field name="name">PO Notification Configuration</field>
        <field name="res_model">purchase.notification.config</field>
        <field name="view_mode">tree,form</field>
    </record>

     <menuitem id="menu_purchase_notification_config" 
              name="PO Notification Config" 
              parent="purchase.menu_purchase_config"
              action="action_purchase_notification_config"/>
</odoo>
