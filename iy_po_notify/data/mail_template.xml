<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="po_approval_notification_email_tem" model="mail.template">
            <field name="name">PO Approval Notification</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">Purchase Order {{ object.name or 'n/a' }} Validated</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-esc="ctx.get('user_name', '')"/>,</p>
                    <p>The following purchase order has been validated:</p>
                    <p>Order Reference: <t t-esc="object.name"/></p>
                    <p>Vendor: <t t-esc="object.partner_id.name"/></p>
                    <p>Amount: <t t-esc="object.amount_total"/></p>
                    <p>Date: <t t-esc="object.date_order"/></p>
                    <p>You can view the order here: 
                        <a t-att-href="'/web#id=%s&amp;model=purchase.order&amp;view_type=form' % object.id">
                            View Purchase Order
                        </a>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>

        </record>
     </data>
</odoo>
