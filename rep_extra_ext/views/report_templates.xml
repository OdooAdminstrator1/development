<odoo>
  <!-- 1) Update the shared layout: center company name + title, add picking name in footer (only for stock.picking internal) -->
  <template id="external_layout_standard_inherit_internal" inherit_id="web.external_layout_standard">


    <xpath expr="//div[contains(@t-attf-class,'header')]/div[1]" position="before">
      <t t-if="o">
        <t t-if="o._name == 'stock.picking' and o.picking_type_id.sequence_code == 'INT'">
          <div class="row">
            <div class="col-12 text-center">
              <h2 class="mt0 mb2" t-esc="company.name"/>
              <h4 class="mt0">Internal Transfer</h4>
            </div>
          </div>
        </t>
      </t>
    </xpath>

    


    <!-- append the picking name to the footer (will repeat on every PDF page) -->
    <xpath expr="//div[contains(@t-attf-class,'footer')]/div" position="before">
      <t t-if="o and o._name == 'stock.picking' and o.picking_type_id.sequence_code == 'INT'">
        <div class="text-left mt2">
            <strong><span t-field="o.name"/></strong><br/>
            <span>Factory Manager:</span><br/>
            <span>Inventory Manager:</span><br/>
            <span>Production Line Manager :</span>         
        </div>
      </t>
    </xpath>
  </template>

  <!-- 2) Modify the picking report itself -->
  <template id="report_picking_inherit_internal" inherit_id="stock.report_picking">


    <xpath expr="//div[@name='div_sched_date']" position="replace" >
      <t t-if="o and o._name == 'stock.picking' and o.picking_type_id.sequence_code == 'INT'">
     
                        <div t-if="o.state" class="col-auto" name="div_sched_date">
                            <strong>Transfer Date:</strong>
                            <t t-if="o.state == 'done'">
                                <p t-field="o.date_done"/>
                            </t>
                            <t t-if="o.state != 'done'">
                                <p t-field="o.scheduled_date"/>
                           </t>
                        </div>

      </t>
    </xpath>

    <xpath expr="(//table[@class='table table-sm'])[1]"  position="before">
        <div class="row mt32 mb32">
                <div>
                  <strong>Source:</strong>
                  <t t-if="o.location_id">
                    <p t-esc="o.location_id.display_name"/>
                  </t>
                  <t t-elif="o.move_ids_without_package and o.move_ids_without_package[0]">
                    <p t-esc="o.move_ids_without_package[0].location_id.display_name"/>
                  </t>
                </div>
                <div>
                  <strong>Destination:</strong>
                  <t t-if="o.location_dest_id">
                    <p t-esc="o.location_dest_id.display_name"/>
                  </t>
                  <t t-elif="o.move_ids_without_package and o.move_ids_without_package[0]">
                    <p t-esc="o.move_ids_without_package[0].location_dest_id.display_name"/>
                  </t>
                </div>
        </div>

    </xpath>


    <!-- Replace the first item table with two variants: internal (no From/To columns) and original (for other types) -->
    <xpath expr="(//table[@class='table table-sm'])[1]" position="replace">
      <!-- Internal transfer table (no From / To per-line) -->
      <t t-if="o.picking_type_id.sequence_code == 'INT'">
        <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">
          <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
          <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>
          <thead>
            <tr>
              <th name="th_product"><strong>Product</strong></th>
              <th><strong>Quantity</strong></th>
              <th name="th_serial_number" class="text-center" t-if="has_serial_number"><strong>Lot/Serial Number</strong></th>
              <th name="th_barcode" class="text-center" t-if="has_barcode"><strong>Product Barcode</strong></th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="o.move_line_ids_without_package" t-as="ml">
              <tr>
                <td>
                  <span t-field="ml.product_id.display_name"/><br/>
                  <span t-field="ml.product_id.description_picking"/>
                </td>
                <td>
                  <span t-if="o.state != 'done'" t-field="ml.product_uom_qty"/>
                  <span t-if="o.state == 'done'" t-field="ml.qty_done"/>
                  <span t-field="ml.product_uom_id" groups="uom.group_uom"/>
                </td>

                <td class="text-center h6" t-if="has_serial_number">
                  <div t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-esc="ml.lot_id.name or ml.lot_name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 400, 'height': 100, 'img_style': 'width:100%;height:35px;'}"/>
                </td>

                <td class="text-center" t-if="has_barcode">
                  <t t-if="product_barcode != ml.product_id.barcode">
                    <span t-if="ml.product_id and ml.product_id.barcode">
                      <div t-field="ml.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:35px;'}"/>
                    </span>
                    <t t-set="product_barcode" t-value="ml.product_id.barcode"/>
                  </t>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </t>

      <!-- Non-internal (original) table — keep original markup for other picking types -->
      <t t-else="">
        <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">
          <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
          <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>
          <thead>
            <tr>
              <th name="th_product"><strong>Product</strong></th>
              <th><strong>Quantity</strong></th>
              <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left" groups="stock.group_stock_multi_locations"><strong>From</strong></th>
              <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations"><strong>To</strong></th>
              <th name="th_serial_number" class="text-center" t-if="has_serial_number"><strong>Lot/Serial Number</strong></th>
              <th name="th_barcode" class="text-center" t-if="has_barcode"><strong>Product Barcode</strong></th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="o.move_line_ids_without_package" t-as="ml">
              <tr>
                <td>
                  <span t-field="ml.product_id.display_name"/><br/>
                  <span t-field="ml.product_id.description_picking"/>
                </td>
                <td>
                  <span t-if="o.state != 'done'" t-field="ml.product_uom_qty"/>
                  <span t-if="o.state == 'done'" t-field="ml.qty_done"/>
                  <span t-field="ml.product_uom_id" groups="uom.group_uom"/>
                </td>
                <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                  <span t-esc="ml.location_id.display_name"/>
                  <t t-if="ml.package_id"><span t-field="ml.package_id"/></t>
                </td>
                <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                  <div>
                    <span t-field="ml.location_dest_id"/>
                    <t t-if="ml.result_package_id"><span t-field="ml.result_package_id"/></t>
                  </div>
                </td>
                <td class=" text-center h6" t-if="has_serial_number">
                  <div t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-esc="ml.lot_id.name or ml.lot_name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 400, 'height': 100, 'img_style': 'width:100%;height:35px;'}"/>
                </td>
                <td class="text-center" t-if="has_barcode">
                  <t t-if="product_barcode != ml.product_id.barcode">
                    <span t-if="ml.product_id and ml.product_id.barcode">
                      <div t-field="ml.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:35px;'}"/>
                    </span>
                    <t t-set="product_barcode" t-value="ml.product_id.barcode"/>
                  </t>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </xpath>

    <!-- Replace package table (second table) similarly: hide From/To for internal -->
    <xpath expr="(//table[@class='table table-sm'])[2]" position="replace">
      <t t-if="o.picking_type_id.sequence_code == 'INT'">
        <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">
          <thead>
            <tr>
              <th name="th_package">Package</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
              <t t-set="package" t-value="package.with_context(picking_id=o.id)"/>
              <td name="td_pk_barcode">
                <div t-field="package.package_id.name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;margin-left: -50px;'}"/><br/>
              </td>
            </tr>
          </tbody>
        </table>
      </t>

      <t t-else="">
        <!-- original package-level table -->
        <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">
          <thead>
            <tr>
              <th name="th_package">Package</th>
              <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">From</th>
              <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">To</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
              <t t-set="package" t-value="package.with_context(picking_id=o.id)"/>
              <td name="td_pk_barcode">
                <div t-field="package.package_id.name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;margin-left: -50px;'}"/><br/>
              </td>
              <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                <span t-field="package.location_id"/>
              </td>
              <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                <span t-field="package.location_dest_id"/>
              </td>
            </tr>
          </tbody>
        </table>
      </t>
    </xpath>

  </template>
</odoo>




