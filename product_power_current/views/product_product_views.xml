<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_product_form_power_current" model="ir.ui.view">
        <field name="name">product.product.form.power.current</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Electrical" name="electrical_group">
                    
                    <label for="power" string="Power / Voltage"/>
                    <div class="o_row d-flex align-items-center gap-2">
                        <field name="power" nolabel="1" style="max-width: 50px;"/>
                        <span class="me-2">W</span>
                        
                        <span class="ms-3 me-1">Min V:</span>
                        <field name="min_voltage" nolabel="1" style="max-width: 50px;"/>
                        <span class="me-2">V</span>
                        
                        <span class="ms-3 me-1">Max V:</span>
                        <field name="max_voltage" nolabel="1" style="max-width: 50px;"/>
                        <span>V</span>
                    </div>

                    <label for="min_current" string="Current"/>
                    <div class="o_row d-flex align-items-center gap-2">
                        <span class="me-1">Min:</span>
                        <field name="min_current" nolabel="1" style="max-width: 50px;"/>
                        <span class="me-2">mA</span>
                        
                        <span class="ms-3 me-1">Max:</span>
                        <field name="max_current" nolabel="1" style="max-width: 50px;"/>
                        <span>mA</span>
                    </div>

                </group>
            </xpath>
        </field>
    </record>

</odoo>
