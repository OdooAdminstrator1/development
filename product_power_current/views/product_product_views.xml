<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_product_form_power_current" model="ir.ui.view">
        <field name="name">product.product.form.power.current</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                        <page string="Electrical" name="Electrical"  invisible="not is_product_variant">
                            <group name="Electrical">
                                <group name="group_power" string="Power" >
                                    <label for="power" />
                                    <div class="o_unit_field" name="power" >
                                        <field name="power" />
                                        <span class="ms-2">W</span>
                                    </div>
                                </group>
                                <group name="group_voltage" string="Voltage" >
                                    <label for="min_voltage" />
                                    <div class="o_unit_field" name="min_voltage" >
                                        <field name="min_voltage" />
                                        <span class="ms-2">V</span>
                                    </div>
                                    <label for="max_voltage" />
                                    <div class="o_unit_field" name="min_voltage" >
                                        <field name="max_voltage" />
                                        <span class="ms-2">V</span>
                                    </div>
                                </group>
                            </group>
                            <group name="panel2">
                                <group name="group_current" string="Current" >
                                        <label for="min_current" />
                                        <div class="o_unit_field" name="min_current" >
                                            <field name="min_current" />
                                            <span class="ms-2">mA</span>
                                        </div>
                                        <label for="max_current" />
                                        <div class="o_unit_field" name="max_current" >
                                            <field name="max_current" />
                                            <span class="ms-2">mA</span>
                                        </div>
                                </group>
                                <group name="group_other" string="Other" >
                                        <label for="dimming" />
                                        <div  name="dimming" >
                                            <field name="dimming" />
                                        </div>
                                        <label for="operation_type" />
                                        <div  name="operation_type" >
                                            <field name="operation_type" />
                                        </div>
                                        <label for="protection" />
                                        <div  name="protection" >
                                            <field name="protection" />
                                        </div>
                                </group>
                            </group>
                        </page>
            </xpath>

        </field>
    </record>

    <record id="view_product_electric_tree" model="ir.ui.view">
        <field name="name">product.product.electric.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree  string="Power Supply" create="false" js_class="product_power_filter_list">
                <field name="id" />
                <field name="default_code"/>
                <field name="name"/>
                <field name="product_template_variant_value_ids" widget="many2many_tags" />
                <field name="standard_price" digits="[16, 2]" />
                <field name="qty_available"  digits="[16, 2]" />
                <field name="min_voltage"  />
                <field name="max_voltage"  />
                <field name="min_current"  />
                <field name="max_current"  />
                <field name="dimming"  />
                <field name="protection"  />

            </tree>
        </field>
    </record>

    <!-- 1. Window Action pointing directly to your specific view ID -->
    <record id="action_product_electric" model="ir.actions.act_window">
        <field name="name">Electric Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="product_power_current.view_product_electric_tree"/>
    </record>

    <menuitem id="menu_product_electric_dashboard"
          name="AESCO Dashboard"
          web_icon="production_order,static/description/icon2.png"
          sequence="15"/>

    <menuitem id="menu_production_order_summary"
              name="Order Summary"
              action="production_order.action_production_order_summary"
              parent="menu_product_electric_dashboard"

              sequence="10"/>

    <!-- 2. Root Menu Item (renders as an app icon on Odoo Home Screen) -->
    <menuitem id="menu_product_electric_root"
              name="Electric Products"
              action="action_product_electric"
              parent="menu_product_electric_dashboard"
              sequence="20"/>

    <menuitem id="menu_product_electric_report_wizard"
              name="Aged Products"
              action="prod_qnt_cost_tracing.action_product_report_wizard"
              parent="menu_product_electric_dashboard" 
              sequence="30"
        />

</odoo>
