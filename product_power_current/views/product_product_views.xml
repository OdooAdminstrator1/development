<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_product_form_power_current" model="ir.ui.view">
        <field name="name">product.product.form.power.current</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                    <group string="Electrical">
                    
                        <!-- Power -->
                        <label for="power"/>
                        <div class="o_unit_field">
                            <field name="power"/>
                            <span>W</span>
                        </div>
                    
                        <!-- Voltage -->
                        <div></div>
                        <div class="o_electrical_row">
                    
                            <label for="min_voltage" class="o_form_label"/>
                            <field name="min_voltage"/>
                            <span>V</span>
                    
                            <label for="max_voltage" class="o_form_label ms-3"/>
                            <field name="max_voltage"/>
                            <span>V</span>
                    
                        </div>
                    
                        <!-- Current -->
                        <div></div>
                        <div class="o_electrical_row">
                    
                            <label for="min_current" class="o_form_label"/>
                            <field name="min_current"/>
                            <span>mA</span>
                    
                            <label for="max_current" class="o_form_label ms-3"/>
                            <field name="max_current"/>
                            <span>mA</span>
                    
                        </div>
                    
                    </group>
            </xpath>
        </field>
    </record>

</odoo>
