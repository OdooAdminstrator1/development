<odoo>
    <data>

        <!-- Inherit Form View to Modify it -->
        <record id="filter_view_purchase_order_filter_inherited" model="ir.ui.view">
            <field name="name">filter_view_purchase_order_filter_inherited</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">

                <xpath expr="//search" position="inside">
                    <field name="total_qty_received"/>
                    <filter name="no_received_line" string="No Received Line" domain="[('total_qty_received', '=', 0)]"/>
                </xpath>

            </field>
        </record>



        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">

                    <field name="old_pric_unit"></field>
                    <field name="discount"/>
                    <field name="discount_type" invisible="1"></field>

                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="replace">

                    <field name="price_unit" invisible="1"></field>

                </xpath>
                <xpath expr="//div[@name='reminder']" position="after">

                    <field name="discount_type"></field>
                    <field name="discount_method" invisible="discount_type == 'none'" ></field>
                    <field name="discount_value" invisible="discount_type in ['none', 'line']" ></field>

                </xpath>
            </field>
        </record>


         <record model="ir.ui.view" id="purchase_old_price_form_view">
        <field name="name">purchase.order.extended.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="after">

                    <field name="old_pric_unit"></field>
                    <field name="discount" invisible="1"/>
                    <field name="discount_type" invisible="1"></field>

                </xpath>

                <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="replace">

                    <field name="price_unit" invisible="1"></field>

                </xpath>

         </field>
         </record>


    </data>
</odoo>