<odoo>
    <record model="ir.ui.view" id="account_payment_advance_view">
		<field name="name">account.payment.advance.view</field>
		<field name="model">account.payment</field>
		<field name="inherit_id" ref="pre_payments.account_payment_advance_view" />
		<field name="arch" type="xml">
			<field name="partner_id" position="after">
				<field name="production_order_id" invisible="not (advance_ok == True and payment_type == 'inbound')" />
			</field>

		</field>
    </record>

    <record id="view_production_order_form" model="ir.ui.view">
        <field name="name">production.order.form</field>
        <field name="model">production.order</field>
        <field name="inherit_id" ref="production_order.view_production_order_form" />
        <field name="arch" type="xml">
			<field name="expected_revenue" position="after">
				<field name="adv_payment"  />
			</field>
		</field>
    </record>


    <record id="view_production_order_tree" model="ir.ui.view">
        <field name="name">production.order.tree</field>
        <field name="model">production.order</field>
        <field name="inherit_id" ref="production_order.view_production_order_tree" />
        <field name="arch" type="xml">
			<field name="manufactured" position="after">
				<field name="adv_payment"  />
			</field>
        </field>
    </record>


</odoo>
