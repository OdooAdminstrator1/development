<odoo>
    <data>
        <record id="view_purchase_order_filter" model="ir.ui.view">
            <field name="name">purchase.order.search.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_purchases']" position="after">
                    <filter string="Has Items Not Received " name="totaly_received" domain="[('totaly_received', '=', 0)]" />
                    <filter string="Has Items Not Invoiced " name="totaly_invoiced" domain="[('totaly_invoiced', '=', 0)]" />

                </xpath>
            </field>
        </record>
    </data>
</odoo>

